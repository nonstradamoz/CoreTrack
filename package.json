{
  "name": "coretrack-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @coretrack/api dev",
    "dev:web": "pnpm --filter @coretrack/web dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "test": "pnpm --recursive test",
    "db:generate": "pnpm --filter @coretrack/db db:generate",
    "db:migrate": "pnpm --filter @coretrack/db db:migrate",
    "db:studio": "pnpm --filter @coretrack/db db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
