# Environment Configuration Template for CoreTrack

# API Backend Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coretrack

# In-Memory Cache & Message Broker (Redis 7)
REDIS_URL=redis://localhost:6379

# Search Engine (Meilisearch)
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=masterKey123CoreTrackSecure

# AWS S3 / Object Storage Configuration
# For AWS S3 Production:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=coretrack-production-attachments
# Leave AWS_S3_ENDPOINT unset for real AWS S3. Set it only for local development (e.g. MinIO):
# AWS_S3_ENDPOINT=http://localhost:9000

# Legacy / MinIO fallback aliases:
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=coretrack-attachments
S3_REGION=us-east-1

# JWT Secrets (Development)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Automated Email & Multi-Provider Failover Engine (Resend + Mailjet)
# The system automatically attempts Resend first (Primary).
# If Resend exhausts quota or fails, it automatically kicks in Mailjet (Fallback).

# Provider 1: Resend (Primary)
RESEND_API_KEY=re_your_resend_api_key_here
# In sandbox testing without custom domain:
SMTP_FROM="CoreTrack <onboarding@resend.dev>"
# In production with verified domain:
# SMTP_FROM="CoreTrack Notifications <notifications@yourdomain.com>"

# Provider 2: Mailjet (Automatic Fallback)
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_SECRET_KEY=your_mailjet_secret_key_here
# MAILJET_FROM="CoreTrack <notifications@yourdomain.com>"

# Provider 3 (Optional): Custom Generic SMTP
# SMTP_HOST=smtp.yourserver.com
# SMTP_PORT=587
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-pass

APP_URL=http://localhost:3000
